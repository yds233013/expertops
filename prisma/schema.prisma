// ExpertOps data model.
//
// Design notes:
//  * Every workflow-relevant transition is recorded in ActivityEvent so the
//    operator UI can show a complete, append-only history.
//  * The job queue (Job + Schedule) lives in PostgreSQL so the worker is
//    persistent and restart-safe without an extra broker.
//  * OutboxMessage is a SIMULATED email outbox. Nothing is ever sent to a real
//    mail server; the worker only flips the row to SENT and records the body.
//  * No protected personal attributes are modelled anywhere. Expert fields are
//    limited to professional/operational data (skills, seniority, rate,
//    timezone, availability).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Operators (internal staff) and authentication
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  activityEvents     ActivityEvent[]
  createdProjects    Project[]        @relation("ProjectCreatedBy")
  createdMatchRuns   MatchRun[]
  createdInvitations Invitation[]     @relation("InvitationCreatedBy")
  verifiedCases      OnboardingCase[] @relation("OnboardingVerifiedBy")
  createdAssignments Assignment[]     @relation("AssignmentCreatedBy")

  // Extension back-relations
  ownedCampaigns         SourcingCampaign[]       @relation("CampaignOwner")
  createdCampaigns       SourcingCampaign[]       @relation("CampaignCreatedBy")
  ownedCandidates        Candidate[]              @relation("CandidateOwner")
  createdCandidates      Candidate[]              @relation("CandidateCreatedBy")
  resolvedDuplicates     DuplicateFlag[]
  publishedRubrics       ScreeningRubricVersion[] @relation("RubricPublishedBy")
  decidedScreenings      Screening[]              @relation("ScreeningDecidedBy")
  screeningReviews       ScreeningReview[]        @relation("ScreeningReviewer")
  resolvedConflicts      ReviewConflict[]
  decidedQualifications  Qualification[]          @relation("QualificationDecidedBy")
  ownedAttentionItems    AttentionItem[]          @relation("AttentionOwner")
  createdBatches         OutreachBatch[]          @relation("BatchCreatedBy")
  approvedBatches        OutreachBatch[]          @relation("BatchApprovedBy")
  createdWorkItems       WorkItem[]               @relation("WorkItemCreatedBy")
  workReviews            WorkReview[]             @relation("WorkReviewer")
  ownedSupportRequests   SupportRequest[]         @relation("SupportOwner")
  supportReplies         SupportReply[]
  createdPaymentBatches  PaymentBatch[]           @relation("BatchCreatedByUser")
  approvedPaymentBatches PaymentBatch[]           @relation("PaymentApprovedBy")
  ownedOffboardingTasks  OffboardingTask[]        @relation("OffboardingOwner")
  confirmedOffboarding   OffboardingTask[]        @relation("OffboardingConfirmedBy")

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Experts
// ---------------------------------------------------------------------------

enum ExpertStatus {
  PROSPECT // sourced into the network, not yet engaged
  ONBOARDING // accepted an invitation and started onboarding
  PENDING_VERIFICATION // submitted onboarding, waiting on a human operator
  VERIFIED // operator-verified, eligible for staffing
  REJECTED // operator rejected the onboarding submission
  ARCHIVED // no longer part of the network
}

model Expert {
  id                  String       @id @default(cuid())
  reference           String       @unique // stable human-facing id, e.g. EXP-0001
  fullName            String
  email               String       @unique
  headline            String
  bio                 String       @default("")
  status              ExpertStatus @default(PROSPECT)
  yearsExperience     Int          @default(0)
  // IANA timezone. Operational scheduling data only - never used as a proxy
  // for any protected attribute.
  timezone            String       @default("UTC")
  // Stored in minor units (cents) to avoid floating point money bugs.
  hourlyRateCents     Int          @default(0)
  currency            String       @default("USD")
  // Self-reported weekly capacity, refined per project via AvailabilityWindow.
  weeklyCapacityHours Int          @default(0)
  notes               String       @default("")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  skills          ExpertSkill[]
  matchCandidates MatchCandidate[]
  invitations     Invitation[]
  availability    AvailabilityWindow[]
  onboardingCase  OnboardingCase?
  assignments     Assignment[]
  portalTokens    ExpertPortalToken[]
  portalSessions  ExpertPortalSession[]
  activityEvents  ActivityEvent[]

  // Extension back-relations
  referredCandidates Candidate[]         @relation("ExpertReferrals")
  candidateRecord    Candidate?          @relation("CandidateExpert")
  duplicateFlags     DuplicateFlag[]
  qualifications     Qualification[]
  attentionItems     AttentionItem[]
  outreachBatchItems OutreachBatchItem[]
  workItems          WorkItem[]
  supportRequests    SupportRequest[]
  paymentItems       PaymentItem[]
  offboardingTasks   OffboardingTask[]

  @@index([status])
  @@index([status, hourlyRateCents])
  @@index([timezone])
}

model Skill {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  category  String   @default("general")
  createdAt DateTime @default(now())

  experts      ExpertSkill[]
  requirements ProjectSkillRequirement[]
}

model ExpertSkill {
  id          String @id @default(cuid())
  expertId    String
  skillId     String
  // 1 = familiar .. 5 = deep specialist. Self-reported, operator adjustable.
  proficiency Int    @default(3)
  yearsUsed   Int    @default(0)

  expert Expert @relation(fields: [expertId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([expertId, skillId])
  @@index([skillId, proficiency])
}

// ---------------------------------------------------------------------------
// Expert portal access (magic-link style, no passwords for experts)
// ---------------------------------------------------------------------------

enum PortalTokenPurpose {
  INVITATION
  ONBOARDING
  GENERAL
}

model ExpertPortalToken {
  id           String             @id @default(cuid())
  expertId     String
  tokenHash    String             @unique
  purpose      PortalTokenPurpose @default(GENERAL)
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime           @default(now())
  // Development-only mirror of the raw token so the simulated outbox can show a
  // clickable link. Never populate this outside local development.
  devPlaintext String?

  expert Expert @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId])
  @@index([expiresAt])
}

model ExpertPortalSession {
  id         String   @id @default(cuid())
  expertId   String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  expert Expert @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT // being written by an operator, not yet open for matching
  MATCHING // requirements frozen enough to score candidates
  INVITING // invitations are out
  STAFFING // at least one expert accepted; operator is assigning seats
  ACTIVE // all seats filled and confirmed
  CLOSED // finished
  CANCELLED // abandoned
}

model Project {
  id                 String        @id @default(cuid())
  code               String        @unique // human-facing id, e.g. PRJ-0001
  title              String
  clientName         String
  description        String        @default("")
  status             ProjectStatus @default(DRAFT)
  seatsRequested     Int           @default(1)
  // Denormalised count of CONFIRMED assignments. Maintained inside the same
  // transaction that creates/releases an assignment, under a row lock on the
  // project, so it can be trusted as the capacity guard.
  seatsFilled        Int           @default(0)
  minYearsExperience Int           @default(0)
  maxHourlyRateCents Int?
  // Preferred working timezone for scheduling overlap scoring.
  preferredTimezone  String        @default("UTC")
  startDate          DateTime?
  endDate            DateTime?
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  createdBy      User                      @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  requirements   ProjectSkillRequirement[]
  matchRuns      MatchRun[]
  invitations    Invitation[]
  availability   AvailabilityWindow[]
  assignments    Assignment[]
  activityEvents ActivityEvent[]

  // Extension back-relations
  campaigns                 SourcingCampaign[]
  qualificationRequirements ProjectQualificationRequirement[]
  attentionItems            AttentionItem[]
  outreachBatches           OutreachBatch[]
  workItems                 WorkItem[]
  supportRequests           SupportRequest[]
  paymentItems              PaymentItem[]
  offboardingTasks          OffboardingTask[]

  @@index([status])
  @@index([createdById])
}

model ProjectSkillRequirement {
  id             String  @id @default(cuid())
  projectId      String
  skillId        String
  // Hard requirement: an expert without it is excluded from matching entirely.
  required       Boolean @default(false)
  minProficiency Int     @default(1)
  // Relative importance when scoring, 1..5.
  weight         Int     @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([projectId, skillId])
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

model MatchRun {
  id               String   @id @default(cuid())
  projectId        String
  createdById      String?
  algorithmVersion String
  // Snapshot of the weights/filters used, so an old run stays explainable even
  // after the project requirements change.
  params           Json
  consideredCount  Int      @default(0)
  candidateCount   Int      @default(0)
  excludedCount    Int      @default(0)
  createdAt        DateTime @default(now())

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  candidates MatchCandidate[]

  @@index([projectId, createdAt])
}

model MatchCandidate {
  id              String  @id @default(cuid())
  matchRunId      String
  expertId        String
  // 0..100, deterministic for a given (expert, project, weights) tuple.
  score           Int
  rank            Int
  // Per-component contributions so the operator can see WHY someone ranked.
  breakdown       Json
  excluded        Boolean @default(false)
  exclusionReason String?

  matchRun    MatchRun     @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  expert      Expert       @relation(fields: [expertId], references: [id], onDelete: Cascade)
  invitations Invitation[]

  @@unique([matchRunId, expertId])
  @@index([matchRunId, rank])
}

// ---------------------------------------------------------------------------
// Invitations
// ---------------------------------------------------------------------------

enum InvitationStatus {
  DRAFT // created, queued for the worker to "send"
  SENT // simulated email dispatched, awaiting expert response
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN // operator pulled it back
}

model Invitation {
  id               String           @id @default(cuid())
  projectId        String
  expertId         String
  matchCandidateId String?
  status           InvitationStatus @default(DRAFT)
  message          String           @default("")
  expiresAt        DateTime
  sentAt           DateTime?
  respondedAt      DateTime?
  remindedAt       DateTime?
  declineReason    String?
  withdrawReason   String?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expert         Expert          @relation(fields: [expertId], references: [id], onDelete: Cascade)
  matchCandidate MatchCandidate? @relation(fields: [matchCandidateId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // One invitation per expert per project. Re-inviting is an explicit reopen of
  // the existing row, which keeps the history in one place.
  @@unique([projectId, expertId])
  @@index([status, expiresAt])
  @@index([expertId, status])
}

// ---------------------------------------------------------------------------
// Availability
// ---------------------------------------------------------------------------

model AvailabilityWindow {
  id           String   @id @default(cuid())
  expertId     String
  // Null means general availability rather than project-specific.
  projectId    String?
  startAt      DateTime
  endAt        DateTime
  hoursPerWeek Int
  note         String   @default("")
  createdAt    DateTime @default(now())

  expert  Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([expertId, startAt])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Onboarding
// ---------------------------------------------------------------------------

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED // waiting on a human operator
  VERIFIED
  REJECTED
}

enum OnboardingItemKind {
  ATTESTATION // expert ticks a box
  TEXT // expert types a value
  REFERENCE // expert supplies an internal reference string (simulated)
}

model OnboardingCase {
  id           String           @id @default(cuid())
  expertId     String           @unique
  status       OnboardingStatus @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  verifiedAt   DateTime?
  verifiedById String?
  decisionNote String?
  nudgedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  expert     Expert           @relation(fields: [expertId], references: [id], onDelete: Cascade)
  verifiedBy User?            @relation("OnboardingVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  items      OnboardingItem[]

  @@index([status])
}

model OnboardingItem {
  id          String             @id @default(cuid())
  caseId      String
  key         String
  label       String
  helpText    String             @default("")
  kind        OnboardingItemKind @default(ATTESTATION)
  required    Boolean            @default(true)
  position    Int                @default(0)
  value       String?
  completedAt DateTime?

  case OnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, key])
  @@index([caseId, position])
}

// ---------------------------------------------------------------------------
// Staffing
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  PROPOSED // operator drafted it, seat not yet consumed
  CONFIRMED // seat consumed
  RELEASED // seat given back
  COMPLETED // engagement finished
}

model Assignment {
  id                     String           @id @default(cuid())
  projectId              String
  expertId               String
  status                 AssignmentStatus @default(PROPOSED)
  allocationHoursPerWeek Int              @default(0)
  rateCents              Int              @default(0)
  currency               String           @default("USD")
  startDate              DateTime?
  endDate                DateTime?
  confirmedAt            DateTime?
  releasedAt             DateTime?
  releaseReason          String?
  createdById            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expert    Expert  @relation(fields: [expertId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Extension back-relations
  workItems        WorkItem[]
  offboardingTasks OffboardingTask[]

  @@unique([projectId, expertId])
  @@index([projectId, status])
  @@index([expertId, status])
}

// ---------------------------------------------------------------------------
// Activity history (append-only)
// ---------------------------------------------------------------------------

enum ActorType {
  OPERATOR
  EXPERT
  /// A candidate acting in the application portal. Carries no user or expert
  /// id: a candidate is not yet either of those things.
  CANDIDATE
  SYSTEM
}

model ActivityEvent {
  id            String    @id @default(cuid())
  actorType     ActorType
  actorUserId   String?
  actorExpertId String?
  actorLabel    String
  // Free-form but conventional: "project", "expert", "invitation", ...
  entityType    String
  entityId      String
  // Dotted verb, e.g. "invitation.accepted".
  action        String
  summary       String
  metadata      Json      @default("{}")
  // Denormalised links so project/expert/candidate timelines are single-index reads.
  projectId     String?
  expertId      String?
  candidateId   String?
  createdAt     DateTime  @default(now())

  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expert    Expert?  @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([projectId, createdAt])
  @@index([expertId, createdAt])
  @@index([candidateId, createdAt])
}

// ---------------------------------------------------------------------------
// Simulated email outbox
// ---------------------------------------------------------------------------

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

model OutboxMessage {
  id           String       @id @default(cuid())
  toEmail      String
  toName       String       @default("")
  subject      String
  template     String
  bodyText     String
  status       OutboxStatus @default(QUEUED)
  attempts     Int          @default(0)
  lastError    String?
  sentAt       DateTime?
  // What this message is about, for filtering in the operator UI.
  relatedType  String?
  relatedId    String?
  projectId    String?
  expertId     String?
  // Development-only portal URL embedded in the message body.
  devPortalUrl String?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([expertId, createdAt])
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Persistent job queue + scheduler
// ---------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED // will be retried
  DEAD // retries exhausted, needs operator attention
  CANCELLED
}

/// Whether a job's deduplication key is safe to delete along with its history.
///
/// DISPOSABLE is for keys that can never be reused because they carry a
/// timestamp or a tick bucket: scheduler history, and one-shot sends keyed by
/// the moment they were queued. Pruning those frees nothing that matters.
///
/// DURABLE is for keys that identify a business event — `onboarding.start:<id>`,
/// `payment.draft:<id>`, `screening.invite:<id>:<revision>`. There the key *is*
/// the record that the event already happened, so deleting it re-arms the
/// effect. Those rows are kept whatever their age.
enum DedupeScope {
  DISPOSABLE
  DURABLE
}

model Job {
  id             String      @id @default(cuid())
  type           String
  payload        Json        @default("{}")
  status         JobStatus   @default(PENDING)
  priority       Int         @default(100) // lower runs first
  runAt          DateTime    @default(now())
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5)
  lockedAt       DateTime?
  lockedBy       String?
  /// Fencing token. Every successful claim mints a new one, so a worker that
  /// lost its job to a lease takeover can be told apart from the worker that
  /// now owns it. Completion and failure are scoped to this value.
  claimId        String?
  /// When the current claim stops being valid. A worker renews this while it
  /// works; another worker may only take the job over once it has passed.
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  lastError      String?
  result         Json?
  // Optional idempotency key. A unique index means "enqueue once" is a
  // database guarantee rather than an application convention.
  dedupeKey      String?     @unique
  /// Whether this row's `dedupeKey` may be freed by pruning.
  ///
  /// Defaults to DURABLE so a caller that says nothing is retained rather than
  /// deleted: losing a key silently re-arms a business effect, and that failure
  /// is invisible until it happens.
  dedupeScope    DedupeScope @default(DURABLE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, runAt, priority])
  @@index([type, status])
  @@index([lockedAt])
  @@index([status, leaseExpiresAt])
  @@index([status, dedupeScope, finishedAt])
}

/// One recorded sign-in attempt, successful or not.
///
/// Kept as rows rather than a counter on `User` so an attempt against an email
/// that does not exist is still recorded — that is the shape most credential
/// stuffing takes, and a counter on a row that does not exist cannot see it.
/// Rows are pruned by the maintenance sweep once they are past the lockout
/// window and no longer evidence of anything.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// Lower-cased, as supplied. May not match any user.
  email     String
  succeeded Boolean
  /// Best-effort client address from the proxy headers. Absent behind some
  /// setups, which is why it never gates on its own.
  clientIp  String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([clientIp, createdAt])
  @@index([createdAt])
}

/// A worker process reporting that it is alive.
///
/// The queue tables say what work exists; they cannot say whether anything is
/// running. Without this, a worker that died looks exactly like a quiet queue
/// until something overdue piles up.
model WorkerHeartbeat {
  /// The configured worker name. One row per worker, updated in place.
  name       String   @id
  pid        Int
  startedAt  DateTime
  lastSeenAt DateTime
  /// Ticks completed since this process started, for a sense of progress.
  ticks      Int      @default(0)
  /// Last tick's outcome, so a worker that is alive but failing is visible.
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lastSeenAt])
}

model Schedule {
  id              String    @id @default(cuid())
  name            String    @unique
  jobType         String
  payload         Json      @default("{}")
  intervalSeconds Int
  enabled         Boolean   @default(true)
  nextRunAt       DateTime  @default(now())
  lastRunAt       DateTime?
  lastJobId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, nextRunAt])
}

// ===========================================================================
// EXTENSION: applications, domain screening, delivery, support and payment
// preparation.
//
// Everything below is additive. No existing table or column changes meaning,
// so the migration is safe to apply to a populated development database.
// ===========================================================================

// ---------------------------------------------------------------------------
// Domains and sourcing
// ---------------------------------------------------------------------------

/// A field of expertise that screening rubrics and project requirements are
/// written against, e.g. "cybersecurity".
model Domain {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  campaigns      SourcingCampaign[]
  templates      ScreeningTemplate[]
  applications   Application[]
  qualifications Qualification[]
  requirements   ProjectQualificationRequirement[]

  @@index([isActive])
}

enum SourcingCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

/// A deliberate push to find more people in a domain, usually opened because a
/// project cannot be staffed from the existing network.
model SourcingCampaign {
  id          String                 @id @default(cuid())
  code        String                 @unique
  name        String
  domainId    String
  /// Set when the campaign exists to fill a specific project shortage.
  projectId   String?
  targetCount Int                    @default(1)
  status      SourcingCampaignStatus @default(DRAFT)
  ownerId     String?
  notes       String                 @default("")
  opensAt     DateTime?
  closesAt    DateTime?
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  domain     Domain      @relation(fields: [domainId], references: [id], onDelete: Restrict)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner      User?       @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  candidates Candidate[]

  @@index([status, domainId])
  @@index([projectId])
}

enum SourceChannelKind {
  REFERRAL
  COMMUNITY
  DIRECT_APPLICATION
  EVENT
  IMPORT
  OTHER
}

/// Where a candidate came from. Communities and referrals are first-class so an
/// operator can see which relationships actually produce qualified experts.
model SourceChannel {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  kind      SourceChannelKind @default(OTHER)
  notes     String            @default("")
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  candidates Candidate[]

  @@index([kind, isActive])
}

// ---------------------------------------------------------------------------
// Candidates and applications
// ---------------------------------------------------------------------------

enum CandidateStage {
  NEW
  DUPLICATE_HOLD
  SCREENING_INVITED
  SCREENING_SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  QUALIFIED
  REJECTED
  WITHDRAWN
}

/// A person in the intake pipeline.
///
/// Deliberately separate from Expert: a candidate is someone being assessed,
/// an expert is someone in the network. Converting one to the other is an
/// explicit, recorded step, never an implicit upgrade.
model Candidate {
  id                  String         @id @default(cuid())
  reference           String         @unique
  fullName            String
  email               String
  headline            String         @default("")
  timezone            String         @default("UTC")
  yearsExperience     Int            @default(0)
  stage               CandidateStage @default(NEW)
  sourceChannelId     String?
  /// Set when an existing expert referred this person.
  referredByExpertId  String?
  campaignId          String?
  /// The operator who owns this relationship.
  relationshipOwnerId String?
  notes               String         @default("")
  nextActionAt        DateTime?
  nextActionNote      String         @default("")
  /// Set when the person asks not to be contacted again. Honoured by the outbox.
  contactOptOutAt     DateTime?
  contactOptOutReason String?
  /// Set once the candidate has been converted into a network expert.
  expertId            String?        @unique
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  sourceChannel     SourceChannel?         @relation(fields: [sourceChannelId], references: [id], onDelete: SetNull)
  referredByExpert  Expert?                @relation("ExpertReferrals", fields: [referredByExpertId], references: [id], onDelete: SetNull)
  campaign          SourcingCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  relationshipOwner User?                  @relation("CandidateOwner", fields: [relationshipOwnerId], references: [id], onDelete: SetNull)
  expert            Expert?                @relation("CandidateExpert", fields: [expertId], references: [id], onDelete: SetNull)
  createdBy         User?                  @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  applications      Application[]
  screenings        Screening[]
  duplicateFlags    DuplicateFlag[]        @relation("FlaggedCandidate")
  matchedByFlags    DuplicateFlag[]        @relation("MatchedCandidate")
  attentionItems    AttentionItem[]
  portalTokens      CandidatePortalToken[]

  @@index([stage])
  @@index([email])
  @@index([relationshipOwnerId, nextActionAt])
  @@index([campaignId])
}

enum ApplicationStatus {
  SUBMITTED
  ACKNOWLEDGED
  SCREENING_STARTED
  CLOSED_QUALIFIED
  CLOSED_REJECTED
  CLOSED_WITHDRAWN
}

/// A structured application to work in a domain.
model Application {
  id              String            @id @default(cuid())
  reference       String            @unique
  candidateId     String
  domainId        String
  campaignId      String?
  status          ApplicationStatus @default(SUBMITTED)
  /// Structured answers keyed by question id. No free-form file upload exists.
  answers         Json              @default("{}")
  /// Synthetic work-sample links. Recorded as text and never fetched.
  workSampleLinks Json              @default("[]")
  submittedAt     DateTime          @default(now())
  acknowledgedAt  DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  domain    Domain    @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([candidateId])
}

enum DuplicateFlagStatus {
  OPEN
  CONFIRMED_SAME
  CONFIRMED_DIFFERENT
}

/// A suspected duplicate person.
///
/// Raised automatically, resolved only by a human. Nothing merges two people
/// without an operator saying so, because a wrong merge destroys history that
/// cannot be recovered.
model DuplicateFlag {
  id                 String              @id @default(cuid())
  candidateId        String
  matchedCandidateId String?
  matchedExpertId    String?
  /// Why the system thinks these may be the same person.
  reason             String
  /// 0-100 heuristic confidence. Advisory only.
  score              Int                 @default(0)
  status             DuplicateFlagStatus @default(OPEN)
  resolvedById       String?
  resolvedAt         DateTime?
  resolutionNote     String?
  createdAt          DateTime            @default(now())

  candidate        Candidate  @relation("FlaggedCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  matchedCandidate Candidate? @relation("MatchedCandidate", fields: [matchedCandidateId], references: [id], onDelete: Cascade)
  matchedExpert    Expert?    @relation(fields: [matchedExpertId], references: [id], onDelete: Cascade)
  resolvedBy       User?      @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([candidateId, matchedCandidateId])
  @@unique([candidateId, matchedExpertId])
  @@index([status])
}

/// Single-use portal link for a candidate completing a screening.
model CandidatePortalToken {
  id           String    @id @default(cuid())
  candidateId  String
  tokenHash    String    @unique
  purpose      String    @default("SCREENING")
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  devPlaintext String?
  createdAt    DateTime  @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([expiresAt])
}

model CandidatePortalSession {
  id          String   @id @default(cuid())
  candidateId String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([candidateId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Screening rubrics and reviews
// ---------------------------------------------------------------------------

model ScreeningTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  domainId    String
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  domain   Domain                   @relation(fields: [domainId], references: [id], onDelete: Restrict)
  versions ScreeningRubricVersion[]

  @@index([domainId, isActive])
}

enum RubricStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// An immutable published rubric.
///
/// Once PUBLISHED, criteria and thresholds never change. Editing produces a new
/// version, so a screening decided last month can still be explained against
/// exactly the rubric that was in force at the time.
model ScreeningRubricVersion {
  id            String       @id @default(cuid())
  templateId    String
  version       Int
  status        RubricStatus @default(DRAFT)
  /// Total weighted score needed for a pass recommendation. Advisory: the
  /// decision is still a reviewer's.
  passThreshold Int          @default(0)
  guidance      String       @default("")
  changeNote    String       @default("")
  publishedAt   DateTime?
  publishedById String?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  template       ScreeningTemplate                 @relation(fields: [templateId], references: [id], onDelete: Cascade)
  publishedBy    User?                             @relation("RubricPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  criteria       RubricCriterion[]
  screenings     Screening[]
  qualifications Qualification[]
  requirements   ProjectQualificationRequirement[]

  @@unique([templateId, version])
  @@index([status])
}

enum EvidenceKind {
  NONE
  WORK_SAMPLE_LINK
  WRITTEN_ANSWER
  REFERENCE_STATEMENT
}

model RubricCriterion {
  id               String       @id @default(cuid())
  rubricVersionId  String
  key              String
  label            String
  /// What a reviewer should look for at each score level.
  scoringGuidance  String       @default("")
  maxScore         Int          @default(5)
  weight           Int          @default(1)
  requiredEvidence EvidenceKind @default(NONE)
  /// A criterion the candidate must pass regardless of total score.
  isGating         Boolean      @default(false)
  position         Int          @default(0)

  rubricVersion ScreeningRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  @@unique([rubricVersionId, key])
  @@index([rubricVersionId, position])
}

enum ScreeningStatus {
  INVITED
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  DECIDED
  EXPIRED
  WITHDRAWN
}

enum ScreeningOutcome {
  APPROVED
  REJECTED
}

/// One candidate assessed against one immutable rubric version.
model Screening {
  id                  String            @id @default(cuid())
  reference           String            @unique
  candidateId         String
  rubricVersionId     String
  status              ScreeningStatus   @default(INVITED)
  outcome             ScreeningOutcome?
  invitedAt           DateTime          @default(now())
  /// Candidate's deadline to submit.
  dueAt               DateTime
  submittedAt         DateTime?
  /// Reviewer's deadline once a submission exists.
  reviewDueAt         DateTime?
  decidedAt           DateTime?
  decidedById         String?
  decisionNote        String?
  /// Feedback shown to the candidate when a revision is requested. Held on the
  /// screening rather than only in the activity log, so the candidate portal
  /// can render it without reading operator history.
  revisionFeedback    String            @default("")
  revisionRequestedAt DateTime?
  currentRevision     Int               @default(0)
  remindersSent       Int               @default(0)
  lastRemindedAt      DateTime?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  candidate      Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  rubricVersion  ScreeningRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  decidedBy      User?                  @relation("ScreeningDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  submissions    ScreeningSubmission[]
  reviews        ScreeningReview[]
  conflict       ReviewConflict?
  qualification  Qualification?
  attentionItems AttentionItem[]

  @@index([status, reviewDueAt])
  @@index([candidateId])
}

model ScreeningSubmission {
  id              String   @id @default(cuid())
  screeningId     String
  revision        Int
  /// Answers keyed by criterion key.
  answers         Json     @default("{}")
  /// Synthetic links, stored as text. Never fetched by the application.
  workSampleLinks Json     @default("[]")
  note            String   @default("")
  /// False when required evidence is missing, which is how an incomplete
  /// submission is represented rather than rejecting it outright.
  isComplete      Boolean  @default(false)
  missingEvidence Json     @default("[]")
  submittedAt     DateTime @default(now())

  screening Screening         @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  reviews   ScreeningReview[]

  @@unique([screeningId, revision])
}

enum ReviewState {
  ASSIGNED
  SUBMITTED
  WITHDRAWN
}

enum ReviewDecision {
  APPROVE
  REJECT
  REQUEST_REVISION
}

/// A human reviewer's assessment. Private notes never leave the operator side.
model ScreeningReview {
  id             String          @id @default(cuid())
  screeningId    String
  submissionId   String?
  reviewerId     String
  state          ReviewState     @default(ASSIGNED)
  decision       ReviewDecision?
  /// Per-criterion scores keyed by criterion key.
  scores         Json            @default("{}")
  /// Shown to the candidate when a revision is requested.
  publicFeedback String          @default("")
  /// Operator-only. Never serialised to a candidate or expert response.
  privateNotes   String          @default("")
  assignedAt     DateTime        @default(now())
  dueAt          DateTime
  submittedAt    DateTime?
  remindersSent  Int             @default(0)
  lastRemindedAt DateTime?

  screening  Screening            @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  submission ScreeningSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  reviewer   User                 @relation("ScreeningReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([screeningId, reviewerId])
  @@index([state, dueAt])
  @@index([reviewerId, state])
}

enum ConflictStatus {
  OPEN
  RESOLVED
}

/// Raised when reviewers of the same screening disagree. Resolution is an
/// authorised operator decision, never an automatic tie-break.
model ReviewConflict {
  id           String          @id @default(cuid())
  screeningId  String          @unique
  status       ConflictStatus  @default(OPEN)
  summary      String
  resolvedById String?
  resolvedAt   DateTime?
  resolution   ReviewDecision?
  note         String?
  createdAt    DateTime        @default(now())

  screening  Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
}

enum QualificationStatus {
  ACTIVE
  NEEDS_REREVIEW
  SUPERSEDED
  REVOKED
}

/// Proof that a named human decided this expert meets a specific rubric version
/// in a domain. Always traceable to the evidence and the decider.
model Qualification {
  id              String              @id @default(cuid())
  expertId        String
  domainId        String
  rubricVersionId String
  screeningId     String?             @unique
  status          QualificationStatus @default(ACTIVE)
  decidedById     String?
  decidedAt       DateTime            @default(now())
  /// Set when the project requirements moved on and this needs looking at.
  rereviewReason  String?
  revokedAt       DateTime?
  revokedById     String?
  note            String              @default("")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  expert        Expert                 @relation(fields: [expertId], references: [id], onDelete: Cascade)
  domain        Domain                 @relation(fields: [domainId], references: [id], onDelete: Restrict)
  rubricVersion ScreeningRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  screening     Screening?             @relation(fields: [screeningId], references: [id], onDelete: SetNull)
  decidedBy     User?                  @relation("QualificationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([expertId, domainId, rubricVersionId])
  @@index([expertId, status])
  @@index([domainId, status])
}

/// What a project will accept. Raising the bar surfaces re-review work rather
/// than silently invalidating people already staffed.
model ProjectQualificationRequirement {
  id                 String   @id @default(cuid())
  projectId          String
  domainId           String
  /// The oldest rubric version the project accepts.
  minRubricVersionId String
  isMandatory        Boolean  @default(true)
  createdAt          DateTime @default(now())

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain           Domain                 @relation(fields: [domainId], references: [id], onDelete: Restrict)
  minRubricVersion ScreeningRubricVersion @relation(fields: [minRubricVersionId], references: [id], onDelete: Restrict)

  @@unique([projectId, domainId])
}

// ---------------------------------------------------------------------------
// Needs-attention queue
// ---------------------------------------------------------------------------

enum AttentionKind {
  /// A real-world blocker an operator has to resolve.
  BUSINESS_BLOCKER
  /// The automation itself broke. Shown separately so a failing job is never
  /// mistaken for a business problem.
  AUTOMATION_FAILURE
}

enum AttentionSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AttentionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// The operator's main working surface.
///
/// One row per unresolved condition, keyed by `dedupeKey` so a sweep that runs
/// every minute cannot produce a minute's worth of identical alerts. Items
/// resolve themselves when the underlying condition goes away.
model AttentionItem {
  id             String            @id @default(cuid())
  dedupeKey      String            @unique
  kind           AttentionKind     @default(BUSINESS_BLOCKER)
  category       String
  severity       AttentionSeverity @default(MEDIUM)
  title          String
  /// The concrete thing that is stuck.
  blocker        String
  /// What it costs if nobody acts.
  impact         String
  /// What to do next.
  nextAction     String
  ownerId        String?
  dueAt          DateTime?
  status         AttentionStatus   @default(OPEN)
  resolvedAt     DateTime?
  resolvedReason String?
  /// Bumped every sweep so a stale item is visible without duplicating it.
  lastSeenAt     DateTime          @default(now())
  metadata       Json              @default("{}")

  projectId        String?
  expertId         String?
  candidateId      String?
  screeningId      String?
  assignmentId     String?
  workItemId       String?
  supportRequestId String?
  paymentBatchId   String?
  jobId            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User?      @relation("AttentionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expert    Expert?    @relation(fields: [expertId], references: [id], onDelete: Cascade)
  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  screening Screening? @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@index([status, severity, dueAt])
  @@index([status, kind])
  @@index([ownerId, status])
  @@index([projectId, status])
}

// ---------------------------------------------------------------------------
// Batched outreach requiring human approval
// ---------------------------------------------------------------------------

enum OutreachBatchKind {
  PROJECT_INVITATION
  REPLACEMENT
  SCREENING_INVITATION
}

enum OutreachBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  /// Dispatch ran but some recipients are still retryable. The batch is not
  /// finished, and calling dispatch again picks up exactly those recipients.
  PARTIALLY_DISPATCHED
  DISPATCHED
  CANCELLED
}

/// A proposed set of outreach messages.
///
/// The system can assemble a batch; only an authorised operator can approve it,
/// and nothing is dispatched before that approval is recorded.
model OutreachBatch {
  id           String              @id @default(cuid())
  reference    String              @unique
  kind         OutreachBatchKind
  status       OutreachBatchStatus @default(DRAFT)
  projectId    String?
  campaignId   String?
  reason       String              @default("")
  note         String              @default("")
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  rejectedById String?
  rejectedAt   DateTime?
  dispatchedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  project    Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?               @relation("BatchApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items      OutreachBatchItem[]

  @@index([status, kind])
  @@index([projectId])
}

/// How far dispatch has got with one recipient.
///
/// The distinction that matters is SKIPPED versus FAILED. A business rule said
/// no (already invited, no seats left, archived) — that is a decision, it will
/// not change on a retry, and the recipient is permanently excluded. Anything
/// else is infrastructure, which says nothing about the recipient's
/// eligibility, so the row stays retryable.
enum OutreachItemState {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model OutreachBatchItem {
  id            String            @id @default(cuid())
  batchId       String
  expertId      String?
  candidateId   String?
  /// Populated once dispatch actually created the invitation.
  ///
  /// Deliberately not unique. An invitation row is reopened rather than
  /// replaced when somebody who declined or withdrew is invited again, so the
  /// same invitation id is legitimately produced by dispatches in two
  /// different batches over time. While this was unique, the second dispatch
  /// died on the constraint and reported a raw Prisma error to the operator.
  invitationId  String?
  /// Why the system proposed this person.
  rationale     String            @default("")
  matchScore    Int?
  dispatchState OutreachItemState @default(PENDING)
  /// How many dispatch attempts this recipient has had.
  attempts      Int               @default(0)
  /// The infrastructure error from the last failed attempt, if any.
  lastError     String?
  dispatchedAt  DateTime?
  /// Set when dispatch skipped this row, e.g. the person opted out meanwhile.
  skippedReason String?

  batch  OutreachBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  expert Expert?       @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([batchId, expertId])
  @@index([batchId])
  @@index([batchId, dispatchState])
  @@index([invitationId])
}

// ---------------------------------------------------------------------------
// Delivery: work items, submissions and reviews
// ---------------------------------------------------------------------------

enum WorkBasis {
  HOURLY
  DELIVERABLE
}

enum WorkItemStatus {
  DRAFT
  ASSIGNED
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  CANCELLED
}

/// A unit of work handed to a staffed expert.
model WorkItem {
  id               String         @id @default(cuid())
  reference        String         @unique
  projectId        String
  assignmentId     String
  expertId         String
  title            String
  instructions     String         @default("")
  basis            WorkBasis      @default(DELIVERABLE)
  dueAt            DateTime?
  status           WorkItemStatus @default(DRAFT)
  currentRevision  Int            @default(0)
  /// Set only by an approving review. The payment basis comes from here.
  approvedQuantity Decimal?       @db.Decimal(10, 2)
  approvedAt       DateTime?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignment  Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  expert      Expert           @relation(fields: [expertId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("WorkItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  submissions WorkSubmission[]
  reviews     WorkReview[]
  paymentItem PaymentItem?

  @@index([projectId, status])
  @@index([expertId, status])
  @@index([status, dueAt])
}

model WorkSubmission {
  id           String   @id @default(cuid())
  workItemId   String
  revision     Int
  summary      String   @default("")
  content      String   @default("")
  /// Synthetic links only; never fetched.
  attachments  Json     @default("[]")
  /// Hours claimed on an hourly item. Verified by the reviewer, not trusted.
  hoursClaimed Decimal? @db.Decimal(10, 2)
  submittedAt  DateTime @default(now())

  workItem WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  reviews  WorkReview[]

  @@unique([workItemId, revision])
}

enum WorkReviewState {
  PENDING
  REVISION_REQUESTED
  APPROVED
}

/// A human review of one submission.
///
/// Deliberately scoped to the submission. Nothing here changes a network-wide
/// standing or ranking for the expert: one piece of work is not a verdict on a
/// person.
model WorkReview {
  id               String          @id @default(cuid())
  workItemId       String
  submissionId     String
  reviewerId       String?
  state            WorkReviewState @default(PENDING)
  /// Structured per-dimension feedback, e.g. accuracy / completeness / clarity.
  feedback         Json            @default("{}")
  summary          String          @default("")
  revisionRequest  String?
  /// Quantity the reviewer actually authorises for payment.
  approvedQuantity Decimal?        @db.Decimal(10, 2)
  decidedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workItem    WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  submission  WorkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer    User?          @relation("WorkReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  paymentItem PaymentItem?

  @@index([workItemId, state])
  @@index([state])
}

// ---------------------------------------------------------------------------
// Expert support requests
// ---------------------------------------------------------------------------

enum SupportCategory {
  ACCESS
  SCOPE_QUESTION
  TOOLING
  SCHEDULING
  PAYMENT
  OTHER
}

enum SupportStatus {
  OPEN
  WAITING_ON_EXPERT
  WAITING_ON_OPS
  RESOLVED
  CLOSED
}

model SupportRequest {
  id               String          @id @default(cuid())
  reference        String          @unique
  expertId         String
  projectId        String?
  category         SupportCategory @default(OTHER)
  subject          String
  message          String
  status           SupportStatus   @default(OPEN)
  ownerId          String?
  /// An operator can mark a request as genuinely blocking. These surface in the
  /// attention queue and stop readiness or delivery from being called done.
  blocksReadiness  Boolean         @default(false)
  blocksDelivery   Boolean         @default(false)
  responseDueAt    DateTime?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  resolvedById     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  expert  Expert         @relation(fields: [expertId], references: [id], onDelete: Cascade)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner   User?          @relation("SupportOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  replies SupportReply[]

  @@index([status, responseDueAt])
  @@index([expertId, status])
  @@index([projectId, status])
}

enum SupportAuthorType {
  OPERATOR
  EXPERT
}

model SupportReply {
  id             String            @id @default(cuid())
  requestId      String
  authorType     SupportAuthorType
  authorUserId   String?
  authorExpertId String?
  body           String
  /// Operator-only note. Never returned to the expert portal.
  internalOnly   Boolean           @default(false)
  createdAt      DateTime          @default(now())

  request    SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorUser User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

// ---------------------------------------------------------------------------
// Payment preparation
//
// This prepares payment data for a finance process that lives outside this
// system. Nothing here moves money, and "exported" is not "paid".
// ---------------------------------------------------------------------------

enum PaymentItemStatus {
  DRAFT
  READY
  IN_BATCH
  EXPORTED
  VOID
}

model PaymentItem {
  id                      String            @id @default(cuid())
  reference               String            @unique
  expertId                String
  projectId               String
  /// One payment item per approved work review. The unique constraint is what
  /// makes draft creation idempotent under duplicate job delivery.
  workItemId              String?           @unique
  workReviewId            String?           @unique
  basis                   WorkBasis
  /// Hours or deliverable count actually authorised by the reviewer.
  quantity                Decimal           @db.Decimal(10, 2)
  /// Agreed rate in minor units. Integer arithmetic throughout.
  rateMinor               Int
  currency                String            @default("USD")
  /// quantity x rateMinor, rounded half-up to a whole minor unit.
  amountMinor             Int
  status                  PaymentItemStatus @default(DRAFT)
  batchId                 String?
  /// Machine-detected problems, e.g. rate mismatch against the assignment.
  discrepancies           Json              @default("[]")
  /// Cleared by an operator with a recorded explanation.
  discrepancyResolvedById String?
  discrepancyResolvedAt   DateTime?
  discrepancyResolution   String?
  notes                   String            @default("")
  /// Set when a correction replaces this item. History is never overwritten.
  supersededById          String?           @unique
  voidedAt                DateTime?
  voidReason              String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  expert       Expert        @relation(fields: [expertId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem     WorkItem?     @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  workReview   WorkReview?   @relation(fields: [workReviewId], references: [id], onDelete: SetNull)
  batch        PaymentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  supersededBy PaymentItem?  @relation("PaymentCorrection", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   PaymentItem?  @relation("PaymentCorrection")

  @@index([status, expertId])
  @@index([batchId])
  @@index([projectId, status])
}

enum PaymentBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXPORTED
  CANCELLED
}

model PaymentBatch {
  id           String             @id @default(cuid())
  reference    String             @unique
  status       PaymentBatchStatus @default(DRAFT)
  currency     String             @default("USD")
  periodStart  DateTime
  periodEnd    DateTime
  totalMinor   Int                @default(0)
  itemCount    Int                @default(0)
  note         String             @default("")
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  exportedAt   DateTime?
  exportedById String?
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy  User?         @relation("BatchCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?         @relation("PaymentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items      PaymentItem[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Offboarding
// ---------------------------------------------------------------------------

enum OffboardingTaskStatus {
  PENDING
  CONFIRMED
  NOT_APPLICABLE
}

/// A checklist item at the end of an engagement.
///
/// Each row records a human confirming they did something outside this system.
/// ExpertOps does not touch external accounts and does not claim to.
model OffboardingTask {
  id               String                @id @default(cuid())
  projectId        String
  expertId         String
  assignmentId     String?
  key              String
  label            String
  description      String                @default("")
  status           OffboardingTaskStatus @default(PENDING)
  ownerId          String?
  dueAt            DateTime?
  confirmedById    String?
  confirmedAt      DateTime?
  confirmationNote String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expert      Expert      @relation(fields: [expertId], references: [id], onDelete: Cascade)
  assignment  Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  owner       User?       @relation("OffboardingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  confirmedBy User?       @relation("OffboardingConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([projectId, expertId, key])
  @@index([status, dueAt])
}
