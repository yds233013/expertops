# Staging configuration. Copy to deploy/staging.env on the host and fill in.
#
#   cp deploy/staging.env.example deploy/staging.env
#   chmod 600 deploy/staging.env
#
# deploy/*.env is gitignored. Nothing in this file is a real value, and the
# application refuses to start on the placeholders: see src/lib/env.ts.

# --- Identity of the deployment ------------------------------------------
# The hostname testers will use. Must already resolve to this host before the
# first start, or Caddy cannot get a certificate.
STAGING_HOSTNAME=staging.expertops.example
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=ops@example.com
# Must match STAGING_HOSTNAME exactly, including https://. Portal and
# invitation links are built from this.
APP_BASE_URL=https://staging.expertops.example

# --- The tester gate ------------------------------------------------------
# One shared credential, handed to invited testers. Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'
TESTER_USERNAME=tester
TESTER_PASSWORD_HASH=$2a$14$REPLACE_WITH_OUTPUT_OF_caddy_hash_password

# --- Application secrets --------------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32
# Not used on a deployment: no demo accounts are seeded. It must still differ
# from the shipped demo password or the application refuses to start.
SEED_DEMO_PASSWORD=REPLACE_WITH_ANY_UNUSED_VALUE

# --- Database -------------------------------------------------------------
# Its own role, its own password, its own database name. Never `expertops`,
# `expertops_test` or `expertops_e2e`: the application refuses those, because
# they are the databases the test suite and the seed are allowed to destroy.
POSTGRES_USER=expertops_app
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_base64_24
POSTGRES_DB=expertops_staging

# --- Optional -------------------------------------------------------------
LOG_FORMAT=json
WORKER_NAME=staging-worker
SESSION_TTL_HOURS=12
PORTAL_TOKEN_TTL_HOURS=168
# Tag of the image to run. Leave unset to build from this checkout.
# EXPERTOPS_IMAGE=expertops:staging
