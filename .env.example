# ---------------------------------------------------------------------------
# ExpertOps local environment
# Copy to `.env` (`cp .env.example .env`) before running anything.
# Every value below points at a LOCAL service. No paid APIs (the optional task
# check is simulated unless TASK_CHECK_PROVIDER=anthropic), no external
# accounts, no real email delivery.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml (host port 5433 to avoid clashing with a local
# PostgreSQL on 5432). If you use your own PostgreSQL instead, point this at it.
DATABASE_URL="postgresql://expertops:expertops@localhost:5433/expertops?schema=public"

# Separate database used by the integration/concurrency tests. It is truncated
# between tests, so never point this at a database you care about.
#
# Guards refuse any database whose name this project does not recognise, and
# refuse the development database outright, so a stray value here fails loudly
# rather than destroying data.
TEST_DATABASE_URL="postgresql://expertops:expertops@localhost:5433/expertops_test?schema=public"

# A third database used only by the Playwright browser suite, so a browser run
# and a vitest run cannot truncate each other's fixtures.
E2E_DATABASE_URL="postgresql://expertops:expertops@localhost:5433/expertops_e2e?schema=public"

# Port the browser suite starts the application on. Deliberately not 3000, so a
# test run never collides with a development server you have open.
E2E_PORT=3100

# Host port that docker compose publishes PostgreSQL on.
EXPERTOPS_DB_PORT=5433

# --- Application ------------------------------------------------------------
NODE_ENV=development

# Which environment this deployment is, as opposed to how the code was built.
# `next start` forces NODE_ENV=production for any production build, including
# the browser suite's local one; the production safety checks key off this
# instead. Leave it unset for a real deployment: it defaults to NODE_ENV, and
# setting it to anything but `production` there switches those checks off.
# EXPERTOPS_ENV=production

# Base URL used when building expert portal links inside simulated emails.
APP_BASE_URL="http://localhost:3000"

# Secret used to derive session and portal token hashes.
# Generate your own with: openssl rand -hex 32
AUTH_SECRET="dev-only-insecure-secret-change-me-0000000000000000000000000000"

# Operator session lifetime in hours.
SESSION_TTL_HOURS=12

# Expert portal magic-link lifetime in hours.
PORTAL_TOKEN_TTL_HOURS=168

# Invitation response deadline in hours (used when an operator does not supply one).
INVITATION_DEFAULT_TTL_HOURS=72

# --- Worker -----------------------------------------------------------------
# Polling interval for the PostgreSQL-backed job queue, in milliseconds.
WORKER_POLL_INTERVAL_MS=1000

# How many jobs a single worker tick claims at once.
WORKER_BATCH_SIZE=5

# How long a claimed job may stay locked before another worker may reclaim it.
WORKER_LOCK_TIMEOUT_SECONDS=120

# Human-readable name for this worker process (shown in the job monitor).
WORKER_NAME="local-worker"

# --- Task checks (docs/task-quality.md) -------------------------------------
# `simulated` (default) needs nothing and bills nothing. `anthropic` tries each
# submitted evaluation task against the Claude API; credentials resolve the way
# the SDK does (ANTHROPIC_API_KEY, or a profile from `ant auth login`).
TASK_CHECK_PROVIDER=simulated
# TASK_CHECK_MODEL=claude-opus-5-5
# TASK_CHECK_EFFORT=medium
# TASK_CHECK_ATTEMPTS=4
# TASK_CHECK_TIMEOUT_MS=60000

# --- Integrations (docs/integrations.md). Each is off until configured. ------
# Email: `simulated` (default) sends nothing. `resend` sends for real, never to
# reserved test domains, and only to EMAIL_ALLOWED_DOMAINS when that is set.
EMAIL_PROVIDER=simulated
# RESEND_API_KEY=
# EMAIL_FROM="ExpertOps <ops@your-verified-domain>"
# EMAIL_ALLOWED_DOMAINS=your-company.com
# RESEND_WEBHOOK_SECRET=
# Slack: an incoming-webhook URL; new attention items are posted to it.
# SLACK_WEBHOOK_URL=
# SLACK_MIN_SEVERITY=MEDIUM
# Stripe Connect payouts. TEST-MODE KEYS ONLY: a live key is refused.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_COUNTRY=US

# --- Screening checks (docs/screening-checks.md). Advisory only. -----------
SCREENING_CHECK_PROVIDER=simulated
# SCREENING_CHECK_MODEL=claude-opus-5-5
# SCREENING_CHECK_EFFORT=medium
# SCREENING_CHECK_TIMEOUT_MS=50000
# `live` looks up cited GitHub accounts and CVEs. Only api.github.com and
# services.nvd.nist.gov are contacted; submitted URLs are never fetched.
SCREENING_EVIDENCE_LOOKUPS=simulated
# GITHUB_LOOKUP_TOKEN=
# NVD_API_KEY=

# --- Access to client systems (docs/access.md). Simulated per system until a
# token is set. Access follows confirmed seats and is revoked when they end.
# GITHUB_ADMIN_TOKEN=github_pat_...   # Administration: write on client repos
# SLACK_BOT_TOKEN=xoxb-...            # channels:manage, groups:write, users:read.email

# --- Development-only conveniences -----------------------------------------
# When true, the operator UI reveals expert portal magic-link URLs in the
# simulated outbox so the whole workflow can be demoed without email.
# MUST be false outside local development.
EXPOSE_PORTAL_LINKS_IN_UI=true

# Label the workspace as sample data: the "Demo workspace · Sample data" badge,
# the sample-data line in the footer and the notice on the public tour. Off by
# default. Turn it on when you share a workspace whose people are made up.
SHOW_SAMPLE_DATA_NOTICE=false

# Password assigned to every seeded demo account. Development only.
SEED_DEMO_PASSWORD="demo-password-123"
