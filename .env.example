# ---------------------------------------------------------------------------
# ExpertOps local environment
# Copy to `.env` (`cp .env.example .env`) before running anything.
# Every value below points at a LOCAL service. No paid APIs, no external
# accounts, no real email delivery.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml (host port 5433 to avoid clashing with a local
# PostgreSQL on 5432). If you use your own PostgreSQL instead, point this at it.
DATABASE_URL="postgresql://expertops:expertops@localhost:5433/expertops?schema=public"

# Separate database used by the integration/concurrency tests. It is truncated
# between tests, so never point this at a database you care about.
TEST_DATABASE_URL="postgresql://expertops:expertops@localhost:5433/expertops_test?schema=public"

# Host port that docker compose publishes PostgreSQL on.
EXPERTOPS_DB_PORT=5433

# --- Application ------------------------------------------------------------
NODE_ENV=development

# Base URL used when building expert portal links inside simulated emails.
APP_BASE_URL="http://localhost:3000"

# Secret used to derive session and portal token hashes.
# Generate your own with: openssl rand -hex 32
AUTH_SECRET="dev-only-insecure-secret-change-me-0000000000000000000000000000"

# Operator session lifetime in hours.
SESSION_TTL_HOURS=12

# Expert portal magic-link lifetime in hours.
PORTAL_TOKEN_TTL_HOURS=168

# Invitation response deadline in hours (used when an operator does not supply one).
INVITATION_DEFAULT_TTL_HOURS=72

# --- Worker -----------------------------------------------------------------
# Polling interval for the PostgreSQL-backed job queue, in milliseconds.
WORKER_POLL_INTERVAL_MS=1000

# How many jobs a single worker tick claims at once.
WORKER_BATCH_SIZE=5

# How long a claimed job may stay locked before another worker may reclaim it.
WORKER_LOCK_TIMEOUT_SECONDS=120

# Human-readable name for this worker process (shown in the job monitor).
WORKER_NAME="local-worker"

# --- Development-only conveniences -----------------------------------------
# When true, the operator UI reveals expert portal magic-link URLs in the
# simulated outbox so the whole workflow can be demoed without email.
# MUST be false outside local development.
EXPOSE_PORTAL_LINKS_IN_UI=true

# Password assigned to every seeded demo account. Development only.
SEED_DEMO_PASSWORD="demo-password-123"
